<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TrainLink</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TrainLink.styles.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>


<body class="bg-light">
    @{
        var role = Context.Session.GetString("Role");
    }
    <nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">

        <div class="container-fluid px-4">

            <a class="navbar-brand d-flex align-items-center gap-2"
               asp-controller="Home"
               asp-action="Index">
                <div class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <span class="fw-bold fs-4">
                    Train<span class="text-primary">Link</span>
                </span>
            </a>
            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <i class="bi bi-list fs-3"></i>
            </button>
            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav mx-auto gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link px-3"
                           asp-controller="Training"
                           asp-action="Index">
                            <i class="bi bi-mortarboard me-1"></i>
                            Training
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3"
                           asp-controller="Report"
                           asp-action="Weekly">
                            <i class="bi bi-journal-text me-1"></i>
                            Weekly Report
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3"
                           asp-controller="Report"
                           asp-action="Final">
                            <i class="bi bi-file-earmark-text me-1"></i>
                            Final Report
                        </a>
                    </li>
                    @if (role =="Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3"
                                    asp-controller="User"
                                    asp-action="Index">
                                    <i class="bi bi-people me-1"></i>
                                        Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3"
                                    asp-controller="Admin"
                                    asp-action="Management">
                                    <i class="bi bi-gear me-1"></i>
                                        Management
                                </a>
                            </li>
                        }
          
                </ul>
                <div class="d-flex align-items-center">
                    <div class="d-none d-lg-flex align-items-center me-3">
                        <div class="user-icon me-2">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">
                                Welcome
                            </small>
                            <span class="fw-semibold">
                                User
                            </span>
                        </div>
                    </div>
                    <a href="/"
                       class="btn btn-outline-danger rounded-3 px-3">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Sign Out
                    </a>
                </div>
            </div>
        </div>
    </nav>
    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<style>
    body {
        font-family: "Segoe UI", sans-serif;
    }
    .brand-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0d6efd;
        color: white;
        border-radius: 12px;
        font-size: 20px;
        box-shadow: 0 4px 10px rgba(13, 110, 253, 0.25);
    }
    .navbar {
        min-height: 72px;
    }
    .navbar-nav .nav-link {
        color: #6c757d;
        font-weight: 500;
        border-radius: 10px;
        transition: all 0.2s ease;
    }
    .navbar-nav .nav-link:hover {
        color: #0d6efd;
        background-color: #f1f5ff;
    }
    .user-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef4ff;
        color: #0d6efd;
        border-radius: 50%;

    }
    .btn-outline-danger {
        transition: all 0.2s ease;
    }
    .btn-outline-danger:hover {
        transform: translateY(-1px);
    }
</style>