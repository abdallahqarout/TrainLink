
@model IEnumerable<TrainLink.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4 px-lg-5">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-lg-row
        justify-content-between align-items-lg-center
        gap-3 mb-4">

        <div>
            <span class="badge bg-primary-subtle text-primary
                px-3 py-2 rounded-pill mb-2">
                Administration
            </span>

            <h2 class="fw-bold mb-1">
                User Management
            </h2>

            <p class="text-secondary mb-0">
                Manage system users and their account information.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Create"
               class="btn btn-primary rounded-3 px-4">
                + Add User
            </a>

        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3
            d-flex align-items-center mb-4">

            <strong class="me-2">
                Success:
            </strong>

            @TempData["Success"]

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3
            d-flex align-items-center mb-4">

            <strong class="me-2">
                Error:
            </strong>

            @TempData["Error"]

        </div>
    }


    <!-- STATISTICS -->
    <div class="row g-4 mb-4">


        <!-- TOTAL USERS -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-secondary mb-1">
                                Total Users
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.Count()
                            </h2>

                        </div>

                        <div class="bg-primary-subtle text-primary
                            rounded-4 d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <span class="fs-4 fw-bold">
                                U
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- STUDENTS -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-secondary mb-1">
                                Students
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.Count(x => x.Role == "Student")
                            </h2>

                        </div>

                        <div class="bg-success-subtle text-success
                            rounded-4 d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <span class="fs-4 fw-bold">
                                S
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- DOCTORS -->
        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-secondary mb-1">
                                Doctors
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.Count(x => x.Role == "Doctor")
                            </h2>

                        </div>

                        <div class="bg-warning-subtle text-warning
                            rounded-4 d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <span class="fs-4 fw-bold">
                                D
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- USERS TABLE -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- TABLE HEADER -->
        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        System Users
                    </h5>

                    <small class="text-secondary">
                        All registered users in the system
                    </small>

                </div>

                <span class="badge bg-light text-dark border
                    rounded-pill px-3 py-2">

                    @Model.Count() Users

                </span>

            </div>

        </div>


        <!-- TABLE -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="px-4 py-3">
                            User
                        </th>

                        <th>
                            Phone
                        </th>

                        <th>
                            Role
                        </th>

                        <th class="text-end px-4">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var user in Model)
                    {

                        <tr>

                            <!-- USER -->
                            <td class="px-4">

                                <div class="d-flex align-items-center">

                                    <div class="bg-primary-subtle
                                        text-primary
                                        rounded-circle
                                        d-flex
                                        align-items-center
                                        justify-content-center
                                        flex-shrink-0"
                                         style="width:45px;height:45px;">

                                        <span class="fw-bold">

                                            @(string.IsNullOrEmpty(user.Name)
                                                ? "U"
                                                : user.Name.Substring(0, 1).ToUpper())

                                        </span>

                                    </div>


                                    <div class="ms-3">

                                        <div class="fw-semibold">
                                            @user.Name
                                        </div>

                                        <small class="text-secondary">
                                            @user.Email
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <!-- PHONE -->
                            <td>

                                @if (string.IsNullOrEmpty(user.Phone))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @user.Phone
                                }

                            </td>


                            <!-- ROLE -->
                            <td>

                                @if (user.Role == "Student")
                                {
                                    <span class="badge bg-success-subtle
                                        text-success
                                        rounded-pill px-3 py-2">
                                        Student
                                    </span>
                                }
                                else if (user.Role == "Doctor")
                                {
                                    <span class="badge bg-warning-subtle
                                        text-warning
                                        rounded-pill px-3 py-2">
                                        Doctor
                                    </span>
                                }
                                else if (user.Role == "CompanySupervisor")
                                {
                                    <span class="badge bg-info-subtle
                                        text-info
                                        rounded-pill px-3 py-2">
                                        Supervisor
                                    </span>
                                }
                                else if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger-subtle
                                        text-danger
                                        rounded-pill px-3 py-2">
                                        Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2">
                                        @user.Role
                                    </span>
                                }
                            </td>
                            <!-- ACTIONS -->
                            <td class="text-end px-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <!-- VIEW -->
                                    <a asp-action="Details"asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-outline-primary
                                        rounded-3 px-3">
                                        View
                                    </a>
                                    <!-- DELETE -->
                                    <form asp-action="Delete"method="post"class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden"name="id"value="@user.UserId" />
                                        <button type="submit"class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                onclick="return confirm('Are you sure you want to delete this user?');">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
