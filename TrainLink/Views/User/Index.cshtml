@model IEnumerable<TrainLink.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4 px-lg-5">

    <!-- ================= HEADER ================= -->

    <div class="d-flex flex-column flex-lg-row
        justify-content-between align-items-lg-center
        gap-3 mb-4">

        <div>

            <span class="badge bg-primary-subtle text-primary
                px-3 py-2 rounded-pill mb-2">
                Administration
            </span>

            <h2 class="fw-bold mb-1">
                User Management
            </h2>

            <p class="text-secondary mb-0">
                Manage users, universities, companies and account passwords.
            </p>

        </div>


        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Create"
               class="btn btn-primary rounded-3 px-4">

                + Add User

            </a>

            <button type="button"
                    class="btn btn-success rounded-3 px-4"
                    data-bs-toggle="modal"
                    data-bs-target="#addUniversityModal">

                + Add University

            </button>

            <button type="button"
                    class="btn btn-info text-white rounded-3 px-4"
                    data-bs-toggle="modal"
                    data-bs-target="#addCompanyModal">

                + Add Company

            </button>

        </div>

    </div>


    <!-- ================= MESSAGES ================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3
            d-flex align-items-center mb-4">

            <strong class="me-2">
                Success:
            </strong>

            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3
            d-flex align-items-center mb-4">

            <strong class="me-2">
                Error:
            </strong>

            @TempData["Error"]

        </div>
    }


    <!-- ================= STATISTICS ================= -->

    <div class="row g-4 mb-4">

        <!-- TOTAL USERS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-secondary mb-1">
                                Total Users
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.Count()
                            </h2>

                        </div>

                        <div class="bg-primary-subtle text-primary
                            rounded-4 d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <span class="fs-4 fw-bold">
                                U
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- STUDENTS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-secondary mb-1">
                                Students
                            </p>

                            <h2 class="fw-bold mb-0">

                                @Model.Count(x =>
                                    x.Role == "Student")

                            </h2>

                        </div>

                        <div class="bg-success-subtle text-success
                            rounded-4 d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <span class="fs-4 fw-bold">
                                S
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- DOCTORS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center">

                        <div>

                            <p class="text-secondary mb-1">
                                Doctors
                            </p>

                            <h2 class="fw-bold mb-0">

                                @Model.Count(x =>
                                    x.Role == "Doctor")

                            </h2>

                        </div>

                        <div class="bg-warning-subtle text-warning
                            rounded-4 d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <span class="fs-4 fw-bold">
                                D
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= USERS TABLE ================= -->

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between
                align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        System Users
                    </h5>

                    <small class="text-secondary">
                        All registered users in the system
                    </small>

                </div>

                <span class="badge bg-light text-dark border
                    rounded-pill px-3 py-2">

                    @Model.Count() Users

                </span>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="px-4 py-3">
                            User
                        </th>

                        <th>
                            Role
                        </th>

                        <th>
                            University
                        </th>

                        <th>
                            Company
                        </th>

                        <th>
                            Student Number
                        </th>

                        <th>
                            Major
                        </th>

                        <th>
                            Password
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <!-- USER -->

                            <td class="px-4">

                                <div class="d-flex align-items-center">

                                    <div class="bg-primary-subtle
                                        text-primary
                                        rounded-circle
                                        d-flex
                                        align-items-center
                                        justify-content-center
                                        flex-shrink-0"
                                         style="width:42px;height:42px;">

                                        <span class="fw-bold">

                                            @(string.IsNullOrEmpty(user.Name)
                                                ? "U"
                                                : user.Name.Substring(0, 1).ToUpper())

                                        </span>

                                    </div>


                                    <div class="ms-3">

                                        <div class="fw-semibold">
                                            @user.Name
                                        </div>

                                        <small class="text-secondary">
                                            @user.Email
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <!-- ROLE -->

                            <td>

                                @if (user.Role == "Student")
                                {
                                    <span class="badge bg-success-subtle
                                        text-success
                                        rounded-pill px-3 py-2">

                                        Student

                                    </span>
                                }

                                else if (user.Role == "Doctor")
                                {
                                    <span class="badge bg-warning-subtle
                                        text-warning
                                        rounded-pill px-3 py-2">

                                        Doctor

                                    </span>
                                }

                                else if (user.Role == "CompanySupervisor")
                                {
                                    <span class="badge bg-info-subtle
                                        text-info
                                        rounded-pill px-3 py-2">

                                        Supervisor

                                    </span>
                                }

                                else if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger-subtle
                                        text-danger
                                        rounded-pill px-3 py-2">

                                        Admin

                                    </span>
                                }

                                else
                                {
                                    <span class="badge bg-secondary-subtle
                                        text-secondary
                                        rounded-pill px-3 py-2">

                                        @user.Role

                                    </span>
                                }

                            </td>


                            <!-- UNIVERSITY -->

                            <td>

                                @if (string.IsNullOrEmpty(user.UniversityName))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @user.UniversityName
                                }

                            </td>


                            <!-- COMPANY -->

                            <td>

                                @if (string.IsNullOrEmpty(user.CompanyName))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @user.CompanyName
                                }

                            </td>


                            <!-- STUDENT NUMBER -->

                            <td>

                                @if (string.IsNullOrEmpty(user.StudentNumber))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @user.StudentNumber
                                }

                            </td>


                            <!-- MAJOR -->

                            <td>

                                @if (string.IsNullOrEmpty(user.Major))
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }
                                else
                                {
                                    @user.Major
                                }

                            </td>


                            <!-- PASSWORD -->

                            <td>

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary
                                    rounded-3"
                                        data-bs-toggle="modal"
                                        data-bs-target="#passwordModal"
                                        data-user-id="@user.UserId"
                                        data-user-name="@user.Name">

                                    Set / Reset

                                </button>

                            </td>


                            <!-- DELETE -->

                            <td>

                                <form asp-action="Delete"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.UserId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger
                                        rounded-3"
                                            onclick="return confirm('Are you sure you want to delete this user?');">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>



<!-- ===================================================== -->
<!-- ADD UNIVERSITY MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="addUniversityModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <form asp-action="AddUniversity"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- HEADER -->

                <div class="modal-header border-0 p-4 bg-success-subtle">

                    <div class="d-flex align-items-center">

                        <div class="bg-success text-white rounded-3
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width:52px;height:52px;">

                            <span class="fw-bold fs-5">
                                U
                            </span>

                        </div>


                        <div>

                            <h5 class="fw-bold mb-1">
                                Add University
                            </h5>

                            <small class="text-secondary">
                                Add a new university and its contact information.
                            </small>

                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body p-4">

                    <div class="row g-4">


                        <!-- UNIVERSITY NAME -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                University Name
                            </label>

                            <input type="text"
                                   name="name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. Applied Science University"
                                   required />

                        </div>


                        <!-- EMAIL -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input type="email"
                                   name="email"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="university@example.com" />

                        </div>


                        <!-- PHONE -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input type="tel"
                                   name="phone"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="+962 6 XXXXXXX" />

                        </div>


                        <!-- ADDRESS -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Address
                            </label>

                            <input type="text"
                                   name="address"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. Amman, Jordan" />

                        </div>


                        <!-- INFORMATION BOX -->

                        <div class="col-12">

                            <div class="bg-light border rounded-3 p-3">

                                <div class="fw-semibold mb-1">
                                    University Information
                                </div>

                                <small class="text-secondary">
                                    Enter the official contact details
                                    for this university.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer border-0 p-4 pt-0">

                    <button type="button"
                            class="btn btn-light border rounded-3 px-4"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-success rounded-3 px-4">

                        Add University

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ===================================================== -->
<!-- ADD COMPANY MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="addCompanyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <form asp-action="AddCompany"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- HEADER -->

                <div class="modal-header border-0 p-4 bg-info-subtle">

                    <div class="d-flex align-items-center">

                        <div class="bg-info text-white rounded-3
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width:52px;height:52px;">

                            <span class="fw-bold fs-5">
                                C
                            </span>

                        </div>


                        <div>

                            <h5 class="fw-bold mb-1">
                                Add Company
                            </h5>

                            <small class="text-secondary">
                                Add a new company and its contact information.
                            </small>

                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <!-- BODY -->

                <div class="modal-body p-4">

                    <div class="row g-4">


                        <!-- COMPANY NAME -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Company Name
                            </label>

                            <input type="text"
                                   name="name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. Orange Jordan"
                                   required />

                        </div>


                        <!-- EMAIL -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input type="email"
                                   name="email"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="company@example.com" />

                        </div>


                        <!-- PHONE -->

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input type="tel"
                                   name="phone"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="+962 6 XXXXXXX" />

                        </div>


                        <!-- ADDRESS -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Address
                            </label>

                            <input type="text"
                                   name="address"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. Amman, Jordan" />

                        </div>


                        <!-- INFORMATION BOX -->

                        <div class="col-12">

                            <div class="bg-light border rounded-3 p-3">

                                <div class="fw-semibold mb-1">
                                    Company Information
                                </div>

                                <small class="text-secondary">
                                    Enter the official contact details
                                    and address for this company.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="modal-footer border-0 p-4 pt-0">

                    <button type="button"
                            class="btn btn-light border rounded-3 px-4"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-info text-white rounded-3 px-4">

                        Add Company

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



<!-- ===================================================== -->
<!-- PASSWORD MODAL -->
<!-- ===================================================== -->

<div class="modal fade"
     id="passwordModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <form asp-action="SetPassword"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header border-0 p-4">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Set / Reset Password
                        </h5>

                        <small class="text-secondary">
                            Create a new password for this user.
                        </small>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body px-4">


                    <input type="hidden"
                           id="passwordUserId"
                           name="userId" />


                    <!-- USER -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            User
                        </label>

                        <input type="text"
                               id="passwordUserName"
                               class="form-control form-control-lg
                        rounded-3 bg-light"
                               readonly />

                    </div>


                    <!-- PASSWORD -->

                    <div class="mb-4">

                        <label class="form-label fw-semibold">
                            New Password
                        </label>

                        <input type="password"
                               name="newPassword"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Enter new password"
                               required />

                    </div>


                    <!-- CONFIRM -->

                    <div class="mb-2">

                        <label class="form-label fw-semibold">
                            Confirm Password
                        </label>

                        <input type="password"
                               name="confirmPassword"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Confirm new password"
                               required />

                    </div>

                </div>


                <div class="modal-footer border-0 px-4 pb-4">

                    <button type="button"
                            class="btn btn-light border rounded-3 px-4"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4">

                        Save Password

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Scripts
{

    <script>

        const passwordModal =
            document.getElementById('passwordModal');


        passwordModal.addEventListener(
            'show.bs.modal',
            function(event) {

                const button =
                    event.relatedTarget;


                const userId =
                    button.getAttribute(
                        'data-user-id'
                    );


                const userName =
                    button.getAttribute(
                        'data-user-name'
                    );


                document.getElementById(
                    'passwordUserId'
                ).value = userId;


                document.getElementById(
                    'passwordUserName'
                ).value = userName;

            }
        );

    </script>

}
