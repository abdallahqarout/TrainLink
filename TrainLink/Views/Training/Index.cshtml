@model IQueryable<DAL.Entities.Training>
@{
    ViewData["Title"] = "Training";
}
@using Microsoft.AspNetCore.Http

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Training</h2>
            <p class="text-muted mb-0">
                Manage student training records
            </p>
        </div>
        @if (Context.Session.GetString("Role") == "Admin")
        {
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Create Training
            </a>
        }
        
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Training ID</th>
                            <th>Student </th>
                            <th>Doctor </th>
                            <th>Company </th>
                            <th>Supervisor </th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var training in Model)
                            {
                                <tr>
                                    <td>
                                        @training.TrainingId
                                    </td>
                                    <td>
                                        @training.Student?.Name
                                    </td>
                                    <td>
                                        @training.Doctor?.Name
                                    </td>
                                    <td>
                                        @training.Company?.Name
                                    </td>
                                    <td>
                                        @training.CompanySupervisor?.Name
                                    </td>
                                    <td>
                                        @training.DateFrom.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @training.DateTo.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @training.Status
                                    </td>
                                    <td class="text-center">
                                        
                                        @if (Context.Session.GetString("Role") == "Admin")
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@training.TrainingId"
                                               class="btn btn-sm btn-outline-info">
                                                Details
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-id="@training.TrainingId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>
                                            <form asp-action="Delete"
                                                  asp-route-id="@training.TrainingId"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Are you sure you want to delete this training?');">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                        
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center py-5 text-muted">
                                    No training records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>