@model IQueryable<DAL.Entities.Training>
@{
    ViewData["Title"] = "Training";
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Training</h2>
            <p class="text-muted mb-0">
                Manage student training records
            </p>
        </div>
        <a asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Create Training
        </a>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Training ID</th>
                            <th>Student ID</th>
                            <th>Doctor ID</th>
                            <th>Company ID</th>
                            <th>Supervisor ID</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var training in Model)
                            {
                                <tr>
                                    <td>
                                        @training.TrainingId
                                    </td>
                                    <td>
                                        @training.StudentId
                                    </td>
                                    <td>
                                        @training.DoctorId
                                    </td>
                                    <td>
                                        @training.CompanyId
                                    </td>
                                    <td>
                                        @training.CompanySupervisorId
                                    </td>
                                    <td>
                                        @training.StartDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @training.EndDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @training.Status
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details"
                                           asp-route-id="@training.TrainingId"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@training.TrainingId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                        <form asp-action="Delete"
                                              asp-route-id="@training.TrainingId"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this training?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center py-5 text-muted">
                                    No training records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>