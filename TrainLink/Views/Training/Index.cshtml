@model IQueryable<DAL.Entities.Training>
@{
    ViewData["Title"] = "Training";
}
@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
@using Microsoft.AspNetCore.Http
<div class="container-fluid py-4 px-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="bg-primary rounded-3 p-2 text-white">
                    <i class="bi bi-kanban-fill fs-5"></i>
                </div>

                <span class="text-primary fw-semibold">
                    TRAINING MANAGEMENT
                </span>
            </div>
            <h2 class="fw-bold mb-1">
                Training Records
            </h2>
            <p class="text-muted mb-0">
                Manage student training assignments and progress.
            </p>
        </div>
        @if (role == "Admin")
        {
            <a asp-action="Create"
               class="btn btn-primary rounded-3 px-4 py-2 mt-3 mt-md-0 shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>
                New Training
            </a>
        }
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">
                                Total Training
                            </p>
                            <h3 class="fw-bold mb-0">
                                @(Model?.Count() ?? 0)
                            </h3>
                        </div>
                        <div class="bg-primary-subtle text-primary rounded-4 p-3">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">
                                Active Training
                            </p>
                            <h3 class="fw-bold mb-0">
                                @(Model?.Count(x => x.Status == "Active") ?? 0)
                            </h3>
                        </div>
                        <div class="bg-success-subtle text-success rounded-4 p-3">
                            <i class="bi bi-activity fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">
                                Completed
                            </p>
                            <h3 class="fw-bold mb-0">
                                @(Model?.Count(x => x.Status == "Completed") ?? 0)
                            </h3>
                        </div>
                        <div class="bg-info-subtle text-info rounded-4 p-3">
                            <i class="bi bi-check2-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center gap-3">
                <div>
                    <h5 class="fw-bold mb-1">
                        All Trainings
                    </h5>
                    <p class="text-muted small mb-0">
                        Overview of all assigned student trainings
                    </p>
                </div>
                <div class="input-group" style="max-width:280px;">
                    <span class="input-group-text bg-light border-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           id="trainingSearch"
                           class="form-control bg-light border-0"
                           placeholder="Search training..." />
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0"
                   id="trainingTable">
                <thead>
                    <tr class="bg-light">
                        <th class="ps-4 py-3 text-muted small">
                            ID
                        </th>
                        <th class="py-3 text-muted small">
                            STUDENT
                        </th>
                        <th class="py-3 text-muted small">
                            DOCTOR
                        </th>
                        <th class="py-3 text-muted small">
                            COMPANY
                        </th>
                        <th class="py-3 text-muted small">
                            SUPERVISOR
                        </th>
                        <th class="py-3 text-muted small">
                            PERIOD
                        </th>
                        <th class="py-3 text-muted small">
                            STATUS
                        </th>
                        @if (role == "Admin")
                        {
                            <th class="py-3 text-muted small text-center">
                                ACTIONS
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var training in Model)
                        {
                            <tr class="training-row">    
                                <td class="ps-4">
                                    <span class="fw-bold text-primary">
                                        #@training.TrainingId
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar">
                                            @training.Student?.Name?.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-semibold">
                                                @training.Student?.Name
                                            </div>
                                            <small class="text-muted">
                                                Student
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-medium">
                                        @training.Doctor?.Name
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-medium">
                                            @training.Company?.Name
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @training.CompanySupervisor?.Name
                                </td>
                                <td>
                                    <div class="small">
                                        <div class="fw-semibold">
                                            @training.DateFrom.ToString("dd MMM yyyy")
                                        </div>
                                        <div class="text-muted">
                                            to @training.DateTo.ToString("dd MMM yyyy")
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (training.Status == "Active")
                                    {
                                        <span class="status active">
                                            <span></span>
                                            Active
                                        </span>
                                    }
                                    else if (training.Status == "Completed")
                                    {
                                        <span class="status completed">
                                            <span></span>
                                            Completed
                                        </span>
                                    }
                                    else if (training.Status == "Pending")
                                    {
                                        <span class="status pending">
                                            <span></span>
                                            Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status other">
                                            <span></span>
                                            @training.Status
                                        </span>
                                    }

                                </td>
                                @if (role == "Admin")
                                {
                                    <td class="text-center">
                                        <div class="dropdown">
                                            <button class="btn btn-light rounded-3"
                                                    type="button"
                                                    data-bs-toggle="dropdown">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                                <li>
                                                    <a asp-action="Details"
                                                       asp-route-id="@training.TrainingId"
                                                       class="dropdown-item">
                                                        <i class="bi bi-eye me-2 text-info"></i>
                                                        View Details
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-action="Edit"
                                                       asp-route-id="@training.TrainingId"
                                                       class="dropdown-item">
                                                        <i class="bi bi-pencil me-2 text-primary"></i>
                                                        Edit Training
                                                    </a>
                                                </li>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li>
                                                    <form asp-action="Delete"
                                                          asp-route-id="@training.TrainingId"
                                                          method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit"
                                                                class="dropdown-item text-danger"
                                                                onclick="return confirm('Are you sure you want to delete this training?');">
                                                            <i class="bi bi-trash me-2"></i>
                                                            Delete Training
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center py-5">
                                <div class="py-4">
                                    <div class="empty-icon mb-3">
                                        <i class="bi bi-journal-x"></i>
                                    </div>
                                    <h5 class="fw-bold">
                                        No Training Records
                                    </h5>
                                    <p class="text-muted mb-0">
                                        There are no training records available yet.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<style>
    body {
        background-color: #eef2f7;
    }

    .card {
        background-color: #ffffff;
        border: 1px solid #dfe5ec !important;
        border-radius: 16px !important;
    }

        .card:hover {
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08) !important;
        }

    .bg-primary {
        background-color: #2563eb !important;
    }

    .text-primary {
        color: #2563eb !important;
    }

    .btn-primary {
        background-color: #2563eb !important;
        border-color: #2563eb !important;
    }

        .btn-primary:hover {
            background-color: #1d4ed8 !important;
            border-color: #1d4ed8 !important;
        }

    .bg-primary-subtle {
        background-color: #dbeafe !important;
    }

    .table thead tr,
    .table-light {
        background-color: #f1f5f9 !important;
    }

    .table thead th {
        color: #475569 !important;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: .05em;
    }

    .training-row {
        transition: background-color .2s ease;
    }

        .training-row:hover {
            background-color: #eff6ff !important;
        }

    .avatar {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background-color: #dbeafe;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 17px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        border-radius: 50rem;
        font-size: 13px;
        font-weight: 600;
    }

        .status span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            display: inline-block;
        }

        .status.active {
            background-color: #dcfce7;
            color: #15803d;
        }

            .status.active span {
                background-color: #16a34a;
            }

        .status.completed {
            background-color: #dbeafe;
            color: #1d4ed8;
        }

            .status.completed span {
                background-color: #2563eb;
            }

        .status.pending {
            background-color: #ffedd5;
            color: #c2410c;
        }

            .status.pending span {
                background-color: #ea580c;
            }

        .status.other {
            background-color: #e2e8f0;
            color: #475569;
        }

            .status.other span {
                background-color: #64748b;
            }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: auto;
        border-radius: 18px;
        background-color: #dbeafe;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .dropdown-item {
        padding: 10px 16px;
    }

        .dropdown-item:hover {
            background-color: #eff6ff;
        }

    .input-group-text {
        color: #2563eb;
    }

    #trainingSearch:focus {
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .15);
        border-color: #93c5fd;
    }

    .card-header {
        border-bottom: 1px solid #edf0f4 !important;
    }
</style>
<script>
    document.getElementById("trainingSearch")?.addEventListener("keyup", function() {
        let value = this.value.toLowerCase();
        document.querySelectorAll(".training-row").forEach(function(row) {
            row.style.display =
                row.innerText.toLowerCase().includes(value)
                    ? "" : "none";
        });
    });
</script>