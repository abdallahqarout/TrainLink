@model DAL.Entities.Training
@{
    ViewData["Title"] = "Training Details";
}
<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                Training Details
            </h3>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        Training ID
                    </label>
                    <div class="form-control bg-light">
                        @Model.TrainingId
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        Student ID
                    </label>
                    <div class="form-control bg-light">
                        @Model.StudentId
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        Doctor ID
                    </label>
                    <div class="form-control bg-light">
                        @Model.DoctorId
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        Company ID
                    </label>
                    <div class="form-control bg-light">
                        @Model.CompanyId
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        Company Supervisor ID
                    </label>
                    <div class="form-control bg-light">
                        @Model.CompanySupervisorId
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        Status
                    </label>
                    <div class="form-control bg-light">
                        @Model.Status
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        Start Date
                    </label>
                    <div class="form-control bg-light">
                        @Model.StartDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">
                        End Date
                    </label>
                    <div class="form-control bg-light">
                        @Model.EndDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <a asp-action="Edit"
                   asp-route-id="@Model.TrainingId"
                   class="btn btn-primary">
                    Edit
                </a>
                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>
            </div>
        </div>
    </div>
</div>