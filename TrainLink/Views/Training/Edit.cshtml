@model DAL.Entities.Training
@{
    ViewData["Title"] = "Edit Training";
}
<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                Edit Training
            </h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit"
                  method="post">
                @Html.AntiForgeryToken()
                <input asp-for="TrainingId"
                       type="hidden" />
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>
                <!-- Student -->
                <div class="mb-3">
                    <label asp-for="StudentId"
                           class="form-label fw-semibold">
                        Student
                    </label>
                    <select asp-for="StudentId"
                            asp-items="ViewBag.Students"
                            class="form-select">
                        <option value="">
                            -- Select Student --
                        </option>
                    </select>
                </div>
                <!-- Doctor -->
                <div class="mb-3">
                    <label asp-for="DoctorId"
                           class="form-label fw-semibold">
                        University Doctor
                    </label>
                    <select asp-for="DoctorId"
                            asp-items="ViewBag.Doctors"
                            class="form-select">
                        <option value="">
                            -- Select Doctor --
                        </option>
                    </select>
                </div>
                <!-- Company -->
                <div class="mb-3">
                    <label asp-for="CompanyId"
                           class="form-label fw-semibold">
                        Company
                    </label>
                    <select asp-for="CompanyId"
                            asp-items="ViewBag.Companies"
                            class="form-select">
                        <option value="">
                            -- Select Company --
                        </option>
                    </select>
                </div>
                <!-- Supervisor -->
                <div class="mb-3">
                    <label asp-for="CompanySupervisorId"
                           class="form-label fw-semibold">
                        Company Supervisor
                    </label>
                    <select asp-for="CompanySupervisorId"
                            asp-items="ViewBag.CompanySupervisors"
                            class="form-select">
                        <option value="">
                            -- Select Supervisor --
                        </option>
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DateFrom"
                               class="form-label fw-semibold">
                            Start Date
                        </label>
                        <input asp-for="DateFrom"
                               type="date"
                               class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DateTo"
                               class="form-label fw-semibold">
                            End Date
                        </label>
                        <input asp-for="DateTo"
                               type="date"
                               class="form-control" />
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Status"
                           class="form-label fw-semibold">
                        Status
                    </label>
                    <select asp-for="Status"
                            class="form-select">
                        <option value="Active">
                            Active
                        </option>
                        <option value="Completed">
                            Completed
                        </option>
                        <option value="Cancelled">
                            Cancelled
                        </option>
                    </select>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}