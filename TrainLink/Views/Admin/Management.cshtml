@model TrainLink.ViewModels.ManagementViewModel

@{
    ViewData["Title"] = "Management";
}

<div class="container-fluid py-4 px-lg-5">

    <div class="d-flex flex-column flex-lg-rowjustify-content-between align-items-lg-centergap-3 mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primarypx-3 py-2 rounded-pill mb-2">
                Administration
            </span>
            <h2 class="fw-bold mb-1">Management</h2>
            <p class="text-secondary mb-0">Manage universities and companies</p>
        </div>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4">
            <strong>Success:</strong>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
            <strong>Error:</strong>
            @TempData["Error"]
        </div>
    }
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-1">Universities</h5>
                            <small class="text-secondary">Registered universities</small>
                        </div>
                        <button type="button"class="btn btn-primary rounded-3 px-3"
                                data-bs-toggle="modal"data-bs-target="#addUniversityModal">
                            + Add University
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4">#</th>
                                    <th>University</th>
                                    <th class="text-end px-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Universities.Any())
                                {
                                    <tr>
                                        <td colspan="3"class="text-center py-5 text-secondary">
                                            No universities found
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var university in Model.Universities)
                                    {
                                        <tr>

                                            <td class="px-4">@university.UniversityId</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-primary-subtle text-primary
                                                        rounded-circle
                                                        d-flex align-items-center
                                                        justify-content-center"
                                                         style="width:40px;height:40px;">
                                                        <span class="fw-bold">
                                                            @(string.IsNullOrEmpty(university.Name)
                                                                ? "U"
                                                                : university.Name.Substring(0, 1).ToUpper())
                                                        </span>
                                                    </div>
                                                    <span class="fw-semibold ms-3">@university.Name</span>
                                                </div>
                                            </td>
                                            
                                            <td class="text-end px-4">

                                                <!-- VIEW -->
                                                <a asp-action="View"
                                                   asp-route-id="@university.UniversityId"
                                                   asp-route-type="University"
                                                   class="btn btn-sm btn-outline-primary rounded-3 px-3 me-1">

                                                    <i class="bi bi-eye me-1"></i>
                                                    View

                                                </a>


                                                <!-- DELETE -->
                                                <form asp-action="DeleteUniversity"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@university.UniversityId" />

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteUniversityModal-@university.UniversityId">

                                                        <i class="bi bi-trash3 me-1"></i>
                                                        Delete

                                                    </button>

                                                </form>
                                            </td>
                                            
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex justify-content-between
                        align-items-center">
                        <div>
                            <h5 class="fw-bold mb-1">Companies</h5>
                            <small class="text-secondary">Registered companies</small>
                        </div>
                        <button type="button"class="btn btn-primary rounded-3 px-3"
                                data-bs-toggle="modal"data-bs-target="#addCompanyModal">
                            + Add Company
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4"> # </th>
                                    <th>Company</th>
                                    <th class="text-end px-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Companies.Any())
                                {
                                    <tr>
                                        <td colspan="3"class="text-center py-5 text-secondary">
                                            No companies found.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var company in Model.Companies)
                                    {
                                        <tr>
                                            <td class="px-4">@company.CompanyId</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-info-subtle text-info
                                                        rounded-circle
                                                        d-flex align-items-center
                                                        justify-content-center"
                                                         style="width:40px;height:40px;">
                                                        <span class="fw-bold">
                                                            @(string.IsNullOrEmpty(company.Name)
                                                                ? "C"
                                                                : company.Name.Substring(0, 1).ToUpper())
                                                        </span>
                                                    </div>
                                                    <span class="fw-semibold ms-3">@company.Name</span>
                                                </div>
                                            </td>
                                            <td class="text-end px-4">

                                                <!-- VIEW -->
                                                <a asp-action="View"
                                                   asp-route-id="@company.CompanyId"
                                                   asp-route-type="Company"
                                                   class="btn btn-sm btn-outline-primary rounded-3 px-3 me-1">

                                                    <i class="bi bi-eye me-1"></i>
                                                    View

                                                </a>


                                                <!-- DELETE -->
                                                <form asp-action="DeleteCompany"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden"name="id"value="@company.CompanyId" />
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                            onclick="return confirm('Are you sure you want to delete this company?');">
                                                        Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade"
     id="addUniversityModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 p-4">
                <div>
                    <h5 class="modal-title fw-bold mb-1">
                        Add University
                    </h5>
                    <small class="text-secondary">
                        Enter university information
                    </small>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-action="AddUniversity"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body px-4">

                    <!-- NAME -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            University Name
                        </label>

                        <input type="text"
                               name="name"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Enter university name"
                               required />

                    </div>


                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Email
                        </label>

                        <input type="email"
                               name="email"
                               class="form-control form-control-lg rounded-3"
                               placeholder="example@university.com"
                               required />

                    </div>


                    <!-- PHONE -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Phone
                        </label>

                        <input type="tel"
                               name="phone"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Enter phone number"
                               required />

                    </div>


                    <!-- ADDRESS -->

                    <div class="mb-2">

                        <label class="form-label fw-semibold">
                            Address
                        </label>

                        <input type="text"
                               name="address"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Enter university address"
                               required />

                    </div>

                </div>


                <div class="modal-footer border-0 p-4">

                    <button type="button"
                            class="btn btn-outline-secondary rounded-3 px-4"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4">

                        Add University

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ADD COMPANY MODAL -->
<div class="modal fade"
     id="addCompanyModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow rounded-4">

            <div class="modal-header border-0 p-4">

                <div>

                    <h5 class="modal-title fw-bold mb-1">
                        Add Company
                    </h5>

                    <small class="text-secondary">
                        Enter company information
                    </small>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <form asp-action="AddCompany"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body px-4">

                    <!-- NAME -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Company Name
                        </label>

                        <input type="text"
                               name="name"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Enter company name"
                               required />

                    </div>


                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Email
                        </label>

                        <input type="email"
                               name="email"
                               class="form-control form-control-lg rounded-3"
                               placeholder="example@company.com"
                               required />

                    </div>


                    <!-- PHONE -->

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Phone
                        </label>

                        <input type="tel"
                               name="phone"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Enter phone number"
                               required />

                    </div>


                    <!-- ADDRESS -->

                    <div class="mb-2">

                        <label class="form-label fw-semibold">
                            Address
                        </label>

                        <input type="text"
                               name="address"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Enter company address"
                               required />

                    </div>

                </div>


                <div class="modal-footer border-0 p-4">

                    <button type="button"
                            class="btn btn-outline-secondary rounded-3 px-4"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4">

                        Add Company

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>