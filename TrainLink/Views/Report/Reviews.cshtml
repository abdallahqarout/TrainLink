@model IQueryable<DAL.Entities.ReportReview>

@{
    ViewData["Title"] = "Report Reviews";
}

<div class="container-fluid py-5 px-lg-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-2">
                Review Management
            </span>

            <h2 class="fw-bold mb-1">
                Report Reviews
            </h2>

            <p class="text-muted mb-0">
                View reviews submitted for training reports.
            </p>
        </div>

    </div>

    <!-- REVIEWS TABLE -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Reviews List
                    </h5>

                    <p class="text-muted small mb-0">
                        Review history for weekly and final reports.
                    </p>
                </div>

                <span class="badge bg-light text-dark border px-3 py-2">
                    @(Model?.Count() ?? 0) Reviews
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="px-4">Review ID</th>
                            <th>Weekly Report</th>
                            <th>Final Report</th>
                            <th>Reviewer</th>
                            <th>Decision</th>
                            <th>Comments</th>
                            <th>Review Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var review in Model)
                            {
                                <tr>

                                    <td class="px-4">
                                        <span class="fw-semibold">
                                            #@review.ReviewId
                                        </span>
                                    </td>

                                    <td>
                                        @if (review.WeeklyReportId.HasValue)
                                        {
                                            <span class="badge bg-info-subtle text-info border">
                                                Weekly #@review.WeeklyReportId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>
                                        @if (review.FinalReportId.HasValue)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border">
                                                Final #@review.FinalReportId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            User #@review.ReviewerUserId
                                        </span>
                                    </td>

                                    <td>
                                        @if (review.Decision == "Approved")
                                        {
                                            <span class="badge bg-success-subtle text-success border px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Approved
                                            </span>
                                        }
                                        else if (review.Decision == "Returned")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border px-3 py-2">
                                                <i class="bi bi-arrow-return-left me-1"></i>
                                                Returned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
                                                @review.Decision
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @(string.IsNullOrWhiteSpace(review.Comments)
                                                ? "-"
                                                : review.Comments)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @review.ReviewDate.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="py-4">

                                        <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                                            <i class="bi bi-chat-square-text fs-1 text-muted"></i>
                                        </div>

                                        <h5 class="fw-bold">
                                            No Reviews Found
                                        </h5>

                                        <p class="text-muted mb-0">
                                            No report reviews have been submitted yet.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>