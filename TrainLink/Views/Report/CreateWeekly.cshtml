@model DAL.Entities.WeeklyReport

@{
    ViewData["Title"] = "Create Weekly Report";
}

<div class="container-fluid py-5 px-lg-5">
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-2">
            Weekly Report
        </span>
        <h2 class="fw-bold mb-1">Create Weekly Report</h2>
        <p class="text-secondary mb-0">
            Submit your weekly training progress, completed tasks and challenges.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">       
        <div class="card-header bg-primary text-white border-0 p-4">
            <div class="d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-3 d-flex align-items-center justify-content-center me-3"
                     style="width:50px;height:50px;">
                    <span class="fw-bold fs-5">WR</span>
                </div>
                <div>
                    <h4 class="fw-bold mb-1">Weekly Training Report</h4>
                    <small class="opacity-75">
                        Complete the information below to submit your report.
                    </small>
                </div>
            </div>
        </div>       
        <div class="card-body p-4 p-lg-5">
            <form asp-controller="Report"
                  asp-action="CreateWeekly"
                  method="post">
                @Html.AntiForgeryToken()             
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center me-2"
                             style="width:38px;height:38px;">
                            <span class="fw-bold">1</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Report Information</h5>
                            <small class="text-secondary">
                                Enter your weekly training information.
                            </small>
                        </div>
                    </div>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="WeekNumber"class="form-label fw-semibold">Week Number</label>
                            <input asp-for="WeekNumber"
                                   type="number"class="form-control form-control-lg rounded-3"
                                   min="1"placeholder="e.g. 1"required />
                            <span asp-validation-for="WeekNumber"class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HoursWorked"class="form-label fw-semibold">Hours Worked</label>
                            <input asp-for="HoursWorked"
                                   type="number"class="form-control form-control-lg rounded-3"
                                   min="0"step="0.5"placeholder="e.g. 40"/>
                            <span asp-validation-for="HoursWorked"class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateFrom"
                                   class="form-label fw-semibold">
                                Start Date
                            </label>
                            <input asp-for="DateFrom"
                                   type="date"
                                   class="form-control form-control-lg rounded-3"
                                   required />
                            <span asp-validation-for="DateFrom"
                                  class="text-danger">
                            </span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateTo"
                                   class="form-label fw-semibold">
                                End Date
                            </label>
                            <input asp-for="DateTo"
                                   type="date"
                                   class="form-control form-control-lg rounded-3"
                                   required />
                            <span asp-validation-for="DateTo"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>
                </div>               
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success-subtle text-success rounded-3 d-flex align-items-center justify-content-center me-2"
                             style="width:38px;height:38px;">
                            <span class="fw-bold">
                                2
                            </span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">
                                Completed Work
                            </h5>
                            <small class="text-secondary">
                                Describe the work and activities you completed.
                            </small>
                        </div>
                    </div>
                    <label asp-for="Tasks"
                           class="form-label fw-semibold">
                        Completed Tasks and Activities
                    </label>
                    <textarea asp-for="Tasks"
                              class="form-control rounded-3"
                              rows="7"
                              placeholder="Describe the tasks and activities you completed during this week..."
                              required></textarea>
                    <span asp-validation-for="Tasks"
                          class="text-danger">
                    </span>
                </div>
                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning-subtle text-warning rounded-3 d-flex align-items-center justify-content-center me-2"
                             style="width:38px;height:38px;">
                            <span class="fw-bold">3</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Challenges</h5>
                            <small class="text-secondary">
                                Mention any difficulties or challenges you faced.
                            </small>
                        </div>
                    </div>
                    <label asp-for="Challenges"
                           class="form-label fw-semibold">
                        Challenges
                    </label>
                    <textarea asp-for="Challenges"
                              class="form-control rounded-3"
                              rows="6"
                              placeholder="Describe any challenges or difficulties you faced during this week..."></textarea>
                    <span asp-validation-for="Challenges"
                          class="text-danger">
                    </span>
                </div>
                <div class="alert alert-info border-0 rounded-4 p-4 mb-4">
                    <div class="d-flex align-items-start">
                        <div class="me-3">
                            <div class="bg-info text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:38px;height:38px;">
                                <span class="fw-bold">
                                    i
                                </span>
                            </div>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Before submitting</h6>
                            <p class="mb-0 text-secondary">
                                After submitting your report, it will automatically
                                be sent to your company supervisor for review.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Report"
                       asp-action="Weekly"
                       class="btn btn-light border rounded-3 px-4">
                        Cancel
                    </a>
                    <button type="submit"
                            class="btn btn-primary rounded-3 px-4">
                        <i class="bi bi-send me-2"></i>
                        Submit Weekly Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
