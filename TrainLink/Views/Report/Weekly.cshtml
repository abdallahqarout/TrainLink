@model IQueryable<DAL.Entities.WeeklyReport>

@{
    ViewData["Title"] = "Weekly Reports";
}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Weekly Reports
            </h2>
            <p class="text-muted mb-0">
                Manage your weekly training reports
            </p>
        </div>
            @if (Context.Session.GetString("Role") == "Student")
        {
            <a asp-controller="Report"
               asp-action="CreateWeekly"
               class="btn btn-primary">
                Create Weekly Report
            </a>
        }
        
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Week</th>
                            <th>Training ID</th>
                            <th>Date From</th>
                            <th>Date To</th>
                            @*<th>Submission Date</th>*@
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var report in Model)
                            {
                                <tr>
                                    <td>
                                        Week @report.WeekNumber
                                    </td>
                                    <td>
                                        @report.TrainingId
                                    </td>
                                    <td>
                                        @report.DateFrom.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @report.DateTo.ToString("dd/MM/yyyy")
                                    </td>
                                    @*td>
                                        @report.SubmissionDate.ToString("dd/MM/yyyy")
                                    </td>*@
                                    <td class="text-center">
                                        <a asp-action="WeeklyDetails"
                                           asp-route-id="@report.WeeklyReportId"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>
                                        @if (Context.Session.GetString("Role") == "Admin")
                                        {
                                            <a asp-action="EditWeekly"
                                               asp-route-id="@report.WeeklyReportId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>
                                            <form asp-action="DeleteWeekly"
                                                  asp-route-id="@report.WeeklyReportId"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Are you sure you want to delete this report?');">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                        
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center py-5 text-muted">
                                    No weekly reports found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>