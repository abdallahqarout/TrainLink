@model IQueryable<DAL.Entities.WeeklyReport>

@{
    ViewData["Title"] = "Weekly Reports";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
<div class="container-fluid py-5 px-lg-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-2">
                Training Reports
            </span>
            <h2 class="fw-bold mb-1">Weekly Reports</h2>
            <p class="text-muted mb-0">Manage and review weekly training reports</p>
        </div>
        @if (role == "Student")
        {
            <a asp-controller="Report"asp-action="CreateWeekly"
               class="btn btn-primary px-4">
                <i class="bi bi-plus-lg me-2"></i>
                Create Weekly Report
            </a>
        }
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Total Reports </p>
                            <h3 class="fw-bold mb-0">
                                @(Model?.Count() ?? 0)
                            </h3>
                        </div>
                        <div class="bg-primary-subtle text-primary rounded-3 p-3">
                            <i class="bi bi-file-earmark-text fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Current Role</p>
                            <h5 class="fw-bold mb-0">@role</h5>
                        </div>
                        <div class="bg-info-subtle text-info rounded-3 p-3">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1"> Weekly Reports List</h5>
                    <p class="text-muted small mb-0">
                        View and manage submitted weekly reports.
                    </p>
                </div>
                <span class="badge bg-light text-dark border px-3 py-2">
                    @(Model?.Count() ?? 0) Reports
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Student </th>
                            <th>Week</th>
                            <th>Date From</th>
                            <th>Date To</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var report in Model)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                                                 style="width:40px;height:40px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                <span class="fw-semibold">
                                                    @(report.Training?.Student?.Name ?? "Unknown Student")
                                                </span>
                                                <small class="d-block text-muted">Training Student</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-success-subtle text-success rounded-3 p-2">
                                                <i class="bi bi-calendar-week"></i>
                                            </div>
                                            <div>
                                                <span class="fw-semibold">
                                                    Week @report.WeekNumber
                                                </span>
                                                <small class="d-block text-muted">Weekly Report</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted">
                                            @report.DateFrom.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted">
                                            @report.DateTo.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @if (report.Status == "PendingSupervisor")
                                        {
                                            <span class="badge bg-warning-subtle text-warning border px-3 py-2">
                                                <i class="bi bi-clock me-1"></i>
                                                Pending Supervisor
                                            </span>
                                        }
                                        else if (report.Status == "PendingDoctor")
                                        {
                                            <span class="badge bg-info-subtle text-info border px-3 py-2">
                                                <i class="bi bi-person-check me-1"></i>
                                                Pending Doctor
                                            </span>
                                        }
                                        else if (report.Status == "ReturnedBySupervisor")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border px-3 py-2">
                                                <i class="bi bi-arrow-return-left me-1"></i>
                                                Returned by Supervisor
                                            </span>
                                        }
                                        else if (report.Status == "ReturnedByDoctor")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border px-3 py-2">
                                                <i class="bi bi-arrow-return-left me-1"></i>
                                                Returned by Doctor
                                            </span>
                                        }
                                        else if (report.Status == "Approved")
                                        {
                                            <span class="badge bg-success-subtle text-success border px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
                                                @report.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                                            <a asp-controller="Report"
                                               asp-action="WeeklyDetails"
                                               asp-route-id="@report.WeeklyReportId"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">
                                                <i class="bi bi-eye me-1"></i>
                                                Details
                                            </a>
                                            @if (role == "CompanySupervisor" && report.Status == "PendingSupervisor")
                                            {
                                                <form asp-controller="Report"
                                                      asp-action="SupervisorApprove"
                                                      asp-route-id="@report.WeeklyReportId"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-success"
                                                            onclick="return confirm('Are you sure you want to approve this report?');">
                                                        <i class="bi bi-check-lg me-1"></i>
                                                        Approve
                                                    </button>
                                                </form>
                                                <a asp-controller="Report"
                                                   asp-action="WeeklyDetails"
                                                   asp-route-id="@report.WeeklyReportId"
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-arrow-return-left me-1"></i>
                                                    Return
                                                </a>
                                            }
                                            @if (role == "Doctor"&& report.Status == "PendingDoctor")
                                            {
                                                <form asp-controller="Report"
                                                      asp-action="DoctorApprove"
                                                      asp-route-id="@report.WeeklyReportId"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-success"
                                                            onclick="return confirm('Are you sure you want to approve this report?');">
                                                        <i class="bi bi-check-lg me-1"></i>
                                                        Approve
                                                    </button>
                                                </form>
                                                <a asp-controller="Report"
                                                   asp-action="WeeklyDetails"
                                                   asp-route-id="@report.WeeklyReportId"
                                                   class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-arrow-return-left me-1"></i>
                                                    Return
                                                </a>
                                            }
                                            @if (role == "Student"
                                                && (report.Status == "ReturnedBySupervisor"
                                                || report.Status == "ReturnedByDoctor"))
                                            {
                                                <a asp-controller="Report"
                                                   asp-action="EditWeekly"
                                                   asp-route-id="@report.WeeklyReportId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil me-1"></i>
                                                    Edit & Resubmit
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"class="text-center py-5">
                                    <div class="py-4">
                                        <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                                            <i class="bi bi-file-earmark-text fs-1 text-muted"></i>
                                        </div>
                                        <h5 class="fw-bold">No Weekly Reports </h5>
                                        <p class="text-muted mb-3">
                                            There are no weekly reports available yet.
                                        </p>
                                        @if (role == "Student")
                                        {
                                            <a asp-controller="Report"asp-action="CreateWeekly"
                                               class="btn btn-primary">
                                                <i class="bi bi-plus-lg me-2"></i>
                                                Create Your First Report
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        background-color: #eef2f7;
    }

    .card {
        background-color: #ffffff;
        border: 1px solid #dfe5ec !important;
        border-radius: 16px !important;
    }

        .card:hover {
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08) !important;
        }

    .bg-primary {
        background-color: #2563eb !important;
    }

    .text-primary {
        color: #2563eb !important;
    }

    .btn-primary {
        background-color: #2563eb !important;
        border-color: #2563eb !important;
    }

        .btn-primary:hover {
            background-color: #1d4ed8 !important;
            border-color: #1d4ed8 !important;
        }

    .bg-primary-subtle {
        background-color: #dbeafe !important;
    }

    .table-light {
        --bs-table-bg: #f1f5f9;
        --bs-table-color: #475569;
    }

    .table thead th {
        color: #475569;
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .table > :not(caption) > * > * {
        border-bottom-color: #e5eaf0;
    }

    .table-hover > tbody > tr:hover > * {
        background-color: #eff6ff;
    }

    .bg-success-subtle {
        background-color: #dcfce7 !important;
    }

    .text-success {
        color: #15803d !important;
    }

    .bg-warning-subtle {
        background-color: #ffedd5 !important;
    }

    .text-warning {
        color: #c2410c !important;
    }

    .bg-info-subtle {
        background-color: #cffafe !important;
    }

    .text-info {
        color: #0891b2 !important;
    }

    .bg-danger-subtle {
        background-color: #fee2e2 !important;
    }

    .text-danger {
        color: #dc2626 !important;
    }

    .bg-secondary-subtle {
        background-color: #e2e8f0 !important;
    }

    .text-secondary {
        color: #475569 !important;
    }

    .bg-light {
        background-color: #f8fafc !important;
    }

    .btn-success {
        background-color: #16a34a;
        border-color: #16a34a;
    }

        .btn-success:hover {
            background-color: #15803d;
            border-color: #15803d;
        }

    .btn-outline-info {
        color: #0891b2;
        border-color: #67e8f9;
    }

        .btn-outline-info:hover {
            background-color: #0891b2;
            border-color: #0891b2;
            color: #ffffff;
        }

    .btn-outline-danger {
        color: #dc2626;
        border-color: #fca5a5;
    }

        .btn-outline-danger:hover {
            background-color: #dc2626;
            border-color: #dc2626;
            color: #ffffff;
        }

    .btn-outline-primary {
        color: #2563eb;
        border-color: #93c5fd;
    }

        .btn-outline-primary:hover {
            background-color: #2563eb;
            border-color: #2563eb;
            color: #ffffff;
        }

    .badge {
        font-weight: 600;
    }

    .table td {
        vertical-align: middle;
    }
</style>