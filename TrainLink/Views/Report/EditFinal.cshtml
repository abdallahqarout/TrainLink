@model DAL.Entities.FinalReport

@{
    ViewData["Title"] = "Edit Final Report";
}

<div class="container py-5">

    ```
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Edit Final Report</h3>
        </div>

        <div class="card-body p-4">

            <form asp-controller="Report"
                  asp-action="EditFinal"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="FinalReportId" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <!-- Training ID -->
                <div class="mb-3">
                    <label asp-for="TrainingId"
                           class="form-label fw-semibold">
                        Training ID
                    </label>

                    <input asp-for="TrainingId"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="TrainingId"
                          class="text-danger">
                    </span>
                </div>

                <!-- Acknowledgement -->
                <div class="mb-3">
                    <label asp-for="Acknowledgement"
                           class="form-label fw-semibold">
                        Acknowledgement
                    </label>

                    <textarea asp-for="Acknowledgement"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Acknowledgement"
                          class="text-danger">
                    </span>
                </div>

                <!-- Company Background -->
                <div class="mb-3">
                    <label asp-for="CompanyBackground"
                           class="form-label fw-semibold">
                        Company Background
                    </label>

                    <textarea asp-for="CompanyBackground"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="CompanyBackground"
                          class="text-danger">
                    </span>
                </div>

                <!-- Company Products -->
                <div class="mb-3">
                    <label asp-for="companyProducts"
                           class="form-label fw-semibold">
                        Company Products
                    </label>

                    <textarea asp-for="companyProducts"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="companyProducts"
                          class="text-danger">
                    </span>
                </div>

                <!-- Company Structure -->
                <div class="mb-3">
                    <label asp-for="CompanyStructure"
                           class="form-label fw-semibold">
                        Company Organizational Structure
                    </label>

                    <textarea asp-for="CompanyStructure"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="CompanyStructure"
                          class="text-danger">
                    </span>
                </div>

                <!-- Formal Training -->
                <div class="mb-3">
                    <label asp-for="FormalReceived"
                           class="form-label fw-semibold">
                        Formal Training Received
                    </label>

                    <textarea asp-for="FormalReceived"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="FormalReceived"
                          class="text-danger">
                    </span>
                </div>

                <!-- Relation To Study -->
                <div class="mb-3">
                    <label asp-for="RelateExpToStudy"
                           class="form-label fw-semibold">
                        Relate Training Experience to Study
                    </label>

                    <textarea asp-for="RelateExpToStudy"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="RelateExpToStudy"
                          class="text-danger">
                    </span>
                </div>

                <!-- Conclusion -->
                <div class="mb-4">
                    <label asp-for="Conclusion"
                           class="form-label fw-semibold">
                        Conclusion
                    </label>

                    <textarea asp-for="Conclusion"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="Conclusion"
                          class="text-danger">
                    </span>
                </div>

                <!-- Submission Date -->
                <div class="mb-4">
                    <label asp-for="SubmissionDate"
                           class="form-label fw-semibold">
                        Submission Date
                    </label>

                    <input asp-for="SubmissionDate"
                           type="datetime-local"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="SubmissionDate"
                          class="text-danger">
                    </span>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Final"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>
    

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
