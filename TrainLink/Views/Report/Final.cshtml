@model IQueryable<DAL.Entities.FinalReport>

@{
    ViewData["Title"] = "Final Reports";
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Final Reports
            </h2>

            <p class="text-muted mb-0">
                Manage final training reports
            </p>
        </div>
        @if (Context.Session.GetString("Role") == "Student")
        {
            <a asp-action="CreateFinal"
               class="btn btn-primary">

                <i class="bi bi-plus-lg"></i>
                Create Final Report

            </a>
            
        }
        

    </div>


    <!-- Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Final Report ID
                            </th>

                            <th>
                                Training ID
                            </th>

                            <th>
                                Submission Date
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var report in Model)
                            {
                                <tr>

                                    <!-- Final Report ID -->
                                    <td>
                                        @report.FinalReportId
                                    </td>


                                    <!-- Training ID -->
                                    <td>
                                        @report.TrainingId
                                    </td>


                                    <!-- Submission Date -->
                                    <td>
                                        @report.SubmissionDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <!-- Details -->
                                        <a asp-action="FinalDetails"
                                           asp-route-id="@report.FinalReportId"
                                           class="btn btn-sm btn-outline-info">

                                            Details

                                        </a>


                                        <!-- Edit -->
                                        <a asp-action="EditFinal"
                                           asp-route-id="@report.FinalReportId"
                                           class="btn btn-sm btn-outline-primary">

                                            Edit

                                        </a>


                                        <!-- Tasks -->
                                        <a asp-action="Tasks"
                                           asp-route-finalReportId="@report.FinalReportId"
                                           class="btn btn-sm btn-outline-success">

                                            Tasks

                                        </a>


                                        <!-- References -->
                                        <a asp-action="References"
                                           asp-route-finalReportId="@report.FinalReportId"
                                           class="btn btn-sm btn-outline-warning">

                                            References

                                        </a>


                                        <!-- Appendices -->
                                        <a asp-action="Appendices"
                                           asp-route-finalReportId="@report.FinalReportId"
                                           class="btn btn-sm btn-outline-secondary">

                                            Appendices

                                        </a>


                                        <!-- Delete -->
                                        <form asp-action="DeleteFinal"
                                              asp-route-id="@report.FinalReportId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this final report?');">

                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center py-5 text-muted">

                                    No final reports found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

