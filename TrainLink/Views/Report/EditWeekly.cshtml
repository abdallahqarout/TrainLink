@model DAL.Entities.WeeklyReport
@{
    ViewData["Title"] = "Edit Weekly Report";
}
<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                Edit Weekly Report
            </h3>
        </div>
        <div class="card-body p-4">
            <form asp-controller="Report"
                  asp-action="EditWeekly"
                  method="post">
                @Html.AntiForgeryToken()
                <input asp-for="WeeklyReportId"
                       type="hidden" />
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>
                <!-- Training ID -->
                <div class="mb-3">
                    <label asp-for="TrainingId"
                           class="form-label fw-semibold">
                        Training ID
                    </label>
                    <input asp-for="TrainingId"
                           type="number"
                           class="form-control"
                           required />
                </div>
                <!-- Report Type -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Report Type
                    </label>
                    <input type="text"
                           class="form-control"
                           value="Weekly"
                           readonly />
                </div>
                <!-- Week Number -->
                <div class="mb-3">
                    <label asp-for="WeekNumber"
                           class="form-label fw-semibold">
                        Week Number
                    </label>
                    <input asp-for="WeekNumber"
                           type="number"
                           class="form-control"
                           min="1" />
                </div>
                <!-- Dates -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate"
                               class="form-label fw-semibold">
                            Date From
                        </label>
                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate"
                               class="form-label fw-semibold">
                            Date To
                        </label>
                        <input asp-for="EndDate"
                               type="date"
                               class="form-control" />
                    </div>
                </div>
                <!-- Tasks -->
                <div class="mb-4">
                    <label asp-for="Tasks"
                           class="form-label fw-semibold">
                        Completed Tasks and Activities
                    </label>
                    <textarea asp-for="Tasks"
                              class="form-control"
                              rows="5"
                              placeholder="Write completed tasks and activities..."></textarea>
                </div>
                <!-- Skills -->
                <div class="mb-4">
                    <label asp-for="Skills"
                           class="form-label fw-semibold">
                        Skills Learned
                    </label>
                    <textarea asp-for="Skills"
                              class="form-control"
                              rows="5"
                              placeholder="Write the skills you learned..."></textarea>
                </div>
                <!-- Remarks -->
                <div class="mb-4">
                    <label asp-for="Remark"
                           class="form-label fw-semibold">
                        Supervisor Remarks
                    </label>
                    <textarea asp-for="Remark"
                              class="form-control"
                              rows="5"
                              placeholder="Write supervisor remarks..."></textarea>
                </div>
                <!-- Submission Date -->
                @*<div class="mb-4">
                    <label asp-for="SubmissionDate"
                           class="form-label fw-semibold">
                        Submission Date
                    </label>
                    <input asp-for="SubmissionDate"
                           type="date"
                           class="form-control"
                           readonly />
                </div>*@
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                    <a asp-action="Weekly"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}